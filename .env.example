# Database connection (local Docker Compose Postgres by default)
DATABASE_URL="postgresql://finance_user:finance_pass@localhost:5432/finance_db?schema=public"

# NextAuth / Auth.js
NEXTAUTH_SECRET="change-this-to-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Postgres credentials used by docker-compose.yml
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_pass
POSTGRES_DB=finance_db
